clear; clc; close all;

% --- Estilo global: fondo blanco y TEXTO NEGRO en todas las figuras ---
% (evita texto gris claro cuando MATLAB usa tema oscuro)
try, settings().matlab.appearance.figure.GraphicsTheme.TemporaryValue = 'light'; end %#ok<TRYNC>
set(groot, 'defaultFigureColor','w', 'defaultAxesColor','w', ...
    'defaultAxesXColor','k', 'defaultAxesYColor','k', 'defaultAxesZColor','k', ...
    'defaultAxesGridColor',[0.3 0.3 0.3], 'defaultAxesFontSize',11, ...
    'defaultAxesTitleFontWeight','bold', 'defaultTextColor','k', ...
    'defaultLegendTextColor','k', 'defaultLegendColor','w', 'defaultLegendEdgeColor','k');

%% ===================== 0. PARAMETROS =====================
archivo  = 'evaluacion_gorra_haptica.xlsx';   % ruta del Excel
DIST_MIN = 400;     % mm  (firmware: distanciaMin)
DIST_MAX = 800;     % mm  (firmware: distanciaMax)
exportar = true;    % guarda tablas en resultados_gorra.xlsx y figuras en PNG

%% ===================== 1. CARGA DE DATOS =====================
if isfile(archivo)
    T = leerParticipantes(archivo);
    fprintf('Datos leidos desde: %s\n\n', archivo);
else
    T = datosEmbebidos();
    fprintf('Excel no encontrado: se usan los datos embebidos.\n\n');
end
N = height(T);

% Etiquetas reales y predichas (1 = obstaculo / vibra)
yReal = T.ObstaculoReal;      % logical
yPred = T.Vibro;              % logical

% Caso de la matriz de confusion
Caso = strings(N,1);
Caso( yReal &  yPred) = "TP";
Caso( yReal & ~yPred) = "FN";
Caso(~yReal &  yPred) = "FP";
Caso(~yReal & ~yPred) = "TN";
T.Caso = Caso;

% Score = cercania al obstaculo en el primer aviso, acotado a [0,1]
% (0 si el motor no vibro). Misma definicion que el Excel.
score = zeros(N,1);
v = T.Vibro & ~isnan(T.Dist1erAviso);
score(v) = min(max((DIST_MAX - T.Dist1erAviso(v)) / (DIST_MAX - DIST_MIN), 0), 1);
T.Score = score;

%% ===================== 2. MATRIZ DE CONFUSION GLOBAL =====================
TP = sum(Caso=="TP"); FN = sum(Caso=="FN");
FP = sum(Caso=="FP"); TN = sum(Caso=="TN");

C = [TP FN; FP TN];
fprintf('========== MATRIZ DE CONFUSION ==========\n');
fprintf('                 Vibra   No vibra   Total\n');
fprintf('Con obstaculo     %3d      %3d       %3d\n', TP, FN, TP+FN);
fprintf('Sin obstaculo     %3d      %3d       %3d\n', FP, TN, FP+TN);
fprintf('Total             %3d      %3d       %3d\n\n', TP+FP, FN+TN, N);

figure('Name','Matriz de confusion','Color','w','Position',[100 100 760 560]);
ax = axes; hold(ax,'on');
Cn = [TP FN; FP TN];
colores = [0.55 0.80 0.55 ; 0.95 0.60 0.60 ;     % fila 1: VP (verde), FN (rojo)
           0.98 0.85 0.45 ; 0.55 0.75 0.95 ];    % fila 2: FP (amarillo), VN (azul)
etiq = {'VP','FN';'FP','VN'};
for i = 1:2
    for j = 1:2
        k = (i-1)*2 + j;
        rectangle(ax,'Position',[j-0.5, 3-i-0.5, 1, 1],'FaceColor',colores(k,:), ...
                  'EdgeColor','k','LineWidth',1.5);
        text(ax, j, 3-i+0.12, sprintf('%d', Cn(i,j)), 'FontSize',34, ...
             'FontWeight','bold','HorizontalAlignment','center','Color','k');
        text(ax, j, 3-i-0.22, sprintf('%s  (%.1f%% de la fila)', etiq{i,j}, ...
             100*Cn(i,j)/sum(Cn(i,:))), 'FontSize',11,'HorizontalAlignment','center','Color','k');
    end
end
% Totales por fila y por columna
text(ax, 2.62, 2, sprintf('Total: %d', TP+FN), 'FontSize',12,'FontWeight','bold','Color','k');
text(ax, 2.62, 1, sprintf('Total: %d', FP+TN), 'FontSize',12,'FontWeight','bold','Color','k');
text(ax, 1, 0.32, sprintf('Total: %d', TP+FP), 'FontSize',12,'FontWeight','bold','HorizontalAlignment','center','Color','k');
text(ax, 2, 0.32, sprintf('Total: %d', FN+TN), 'FontSize',12,'FontWeight','bold','HorizontalAlignment','center','Color','k');
set(ax,'XTick',[1 2],'XTickLabel',{'Vibra','No vibra'}, ...
       'YTick',[1 2],'YTickLabel',{'Sin obstaculo','Con obstaculo'}, ...
       'TickLength',[0 0],'FontSize',12,'Box','on','Layer','top');
xlim(ax,[0.5 3.2]); ylim(ax,[0.2 2.5]); axis(ax,'equal'); xlim(ax,[0.5 3.2]); ylim(ax,[0.2 2.5]);
xlabel(ax,'Respuesta de la gorra (prediccion)','FontSize',12,'Color','k');
ylabel(ax,'Condicion real','FontSize',12,'Color','k');
title(ax,'Matriz de confusion - gorra haptica (N = 15)','FontSize',14,'Color','k');

%% ===================== 3. TABLA DE SENSIBILIDAD, PRECISION Y DEMAS =====================
sens = TP/(TP+FN);                 % sensibilidad / recall / TPR
espe = TN/(TN+FP);                 % especificidad
prec = TP/(TP+FP);                 % precision / VPP
vpn  = TN/(TN+FN);                 % valor predictivo negativo
exac = (TP+TN)/N;                  % exactitud
f1   = 2*prec*sens/(prec+sens);    % F1
fnr  = FN/(TP+FN);                 % tasa de falsos negativos (error critico)
fpr  = FP/(FP+TN);                 % tasa de falsos positivos
bacc = (sens+espe)/2;              % exactitud balanceada
mcc  = (TP*TN - FP*FN)/sqrt((TP+FP)*(TP+FN)*(TN+FP)*(TN+FN));  % Matthews

[sL,sU] = wilson(TP, TP+FN);
[eL,eU] = wilson(TN, TN+FP);
[pL,pU] = wilson(TP, TP+FP);
[xL,xU] = wilson(TP+TN, N);

Metrica = ["Sensibilidad (TPR)";"Especificidad (TNR)";"Precision (VPP)"; ...
           "Valor predictivo negativo";"Exactitud";"Exactitud balanceada"; ...
           "F1";"Tasa de falsos negativos (critico)";"Tasa de falsos positivos"; ...
           "Coeficiente de Matthews"];
Formula = ["VP/(VP+FN)";"VN/(VN+FP)";"VP/(VP+FP)";"VN/(VN+FN)"; ...
           "(VP+VN)/N";"(Sens+Esp)/2";"2*Prec*Sens/(Prec+Sens)"; ...
           "FN/(VP+FN)";"FP/(FP+VN)";"(VP*VN-FP*FN)/sqrt(...)"];
Valor = [sens;espe;prec;vpn;exac;bacc;f1;fnr;fpr;mcc];
ICinf = [sL;eL;pL;NaN;xL;NaN;NaN;NaN;NaN;NaN];
ICsup = [sU;eU;pU;NaN;xU;NaN;NaN;NaN;NaN;NaN];
TablaMetricas = table(Metrica, Formula, round(Valor,4), round(ICinf,4), round(ICsup,4), ...
    'VariableNames',{'Metrica','Formula','Valor','IC95_inf_Wilson','IC95_sup_Wilson'});

fprintf('========== TABLA DE METRICAS (punto de operacion real) ==========\n');
disp(TablaMetricas);
fprintf('Nota: con N = 15 los IC95%% son amplios; interpretar con cautela.\n\n');

%% ===================== 4. CURVA ROC Y AUC =====================
% Se usa el score continuo (cercania al primer aviso). Positivo = hay obstaculo.
[Xroc, Yroc, thr, AUC_perf] = perfcurve(yReal, score, true);

% Umbrales manuales (valores distintos del score) para la tabla
umbrales = unique([2; score; 0], 'stable');
umbrales = sort(umbrales, 'descend');
nU = numel(umbrales);

VP = zeros(nU,1); FPu = zeros(nU,1); FNu = zeros(nU,1); VNu = zeros(nU,1);
for k = 1:nU
    pred = score >= umbrales(k);
    VP(k)  = sum( pred &  yReal);
    FPu(k) = sum( pred & ~yReal);
    FNu(k) = sum(~pred &  yReal);
    VNu(k) = sum(~pred & ~yReal);
end
TPRu  = VP ./ (VP + FNu);
FPRu  = FPu ./ (FPu + VNu);
ESPu  = 1 - FPRu;
PRECu = VP ./ (VP + FPu);              % NaN cuando no hay predicciones positivas
EXACu = (VP + VNu) / N;
DIST  = sqrt(FPRu.^2 + (1 - TPRu).^2); % distancia al punto ideal (0,1)

% AUC por regla del trapecio (ordenado por FPR)
[FPRs, ord] = sortrows([FPRu TPRu]);
AUC_trapz = trapz(FPRs(:,1), FPRs(:,2));

% AUC como probabilidad: P(score+ > score-) + 0.5*P(empate)  (Mann-Whitney)
sp = score(yReal); sn = score(~yReal);
AUC_prob = 0;
for i = 1:numel(sp)
    AUC_prob = AUC_prob + sum(sp(i) > sn) + 0.5*sum(sp(i) == sn);
end
AUC_prob = AUC_prob / (numel(sp)*numel(sn));

% IC95% del AUC por bootstrap estratificado
rng(1); B = 2000; aucB = zeros(B,1);
for b = 1:B
    ip = randi(numel(sp), numel(sp), 1);
    in = randi(numel(sn), numel(sn), 1);
    a = sp(ip); c = sn(in); s = 0;
    for i = 1:numel(a)
        s = s + sum(a(i) > c) + 0.5*sum(a(i) == c);
    end
    aucB(b) = s / (numel(a)*numel(c));
end
AUC_ci = prctile(aucB, [2.5 97.5]);

[~, iOpt] = min(DIST);   % umbral optimo (mas cercano a (0,1))

TablaROC = table(umbrales, VP, FPu, FNu, VNu, TPRu, ESPu, FPRu, PRECu, EXACu, DIST, ...
    'VariableNames',{'Umbral_tau','VP','FP','FN','VN','Sensibilidad_TPR', ...
                     'Especificidad','FPR','Precision','Exactitud','Dist_a_0_1'});
fprintf('========== TABLA SENSIBILIDAD / PRECISION POR UMBRAL ==========\n');
disp(round_table(TablaROC, 4));
fprintf('AUC (trapecio)            : %.4f\n', AUC_trapz);
fprintf('AUC (perfcurve)           : %.4f\n', AUC_perf);
fprintf('AUC (prob. Mann-Whitney)  : %.4f\n', AUC_prob);
fprintf('AUC IC95%% bootstrap       : [%.3f , %.3f]\n', AUC_ci(1), AUC_ci(2));
fprintf('Umbral optimo (cercano a (0,1)): tau = %.4f (Sens = %.3f, FPR = %.3f)\n\n', ...
        umbrales(iOpt), TPRu(iOpt), FPRu(iOpt));

figure('Name','Curva ROC','Color','w');
plot(Xroc, Yroc, '-o', 'LineWidth', 2, 'MarkerFaceColor', [0.00 0.45 0.74]); hold on;
plot([0 1],[0 1],'k--','LineWidth',1);
plot(fpr, sens, 's', 'MarkerSize', 12, 'MarkerFaceColor',[0.85 0.33 0.10], ...
     'MarkerEdgeColor','k');
plot(FPRu(iOpt), TPRu(iOpt), 'p', 'MarkerSize', 15, 'MarkerFaceColor',[0.93 0.69 0.13], ...
     'MarkerEdgeColor','k');
grid on; axis square; xlim([0 1]); ylim([0 1.02]);
xlabel('Tasa de falsos positivos (1 - Especificidad)');
ylabel('Tasa de verdaderos positivos (Sensibilidad)');
title(sprintf('Curva ROC - gorra haptica (AUC = %.3f, IC95%% [%.2f, %.2f])', ...
      AUC_trapz, AUC_ci(1), AUC_ci(2)));
legend({'Curva ROC','Azar (AUC = 0.5)','Punto de operacion real','Umbral optimo'}, ...
       'Location','southeast');

%% ===================== 5. GRAFICOS DE DISPERSION =====================
cols = struct('TP',[0.00 0.60 0.30],'TN',[0.00 0.45 0.74], ...
              'FP',[0.93 0.69 0.13],'FN',[0.85 0.10 0.10]);
marc = struct('TP','o','TN','s','FP','^','FN','x');

% 5a. Score por participante
figure('Name','Dispersion: score por participante','Color','w'); hold on;
casos = ["TP","TN","FP","FN"]; h = gobjects(0); nombres = strings(0);
for c = casos
    idx = find(T.Caso == c);
    if isempty(idx), continue; end
    if c == "FN"
        h(end+1) = scatter(idx, T.Score(idx), 130, cols.(c), marc.(c), 'LineWidth', 2.5); %#ok<SAGROW>
    else
        h(end+1) = scatter(idx, T.Score(idx), 110, cols.(c), marc.(c), 'filled', ...
                           'MarkerEdgeColor','k','LineWidth', 1.2); %#ok<SAGROW>
    end
    nombres(end+1) = c; %#ok<SAGROW>
end
yline(umbrales(iOpt), '--k', sprintf('\\tau optimo = %.2f', umbrales(iOpt)), 'LabelHorizontalAlignment','left');
text(1:N, T.Score + 0.05, cellstr(T.ID), 'HorizontalAlignment','center','FontSize',9,'Color','k');
xlabel('Participante'); ylabel('Score (cercania al obstaculo en el primer aviso)');
title('Dispersion del score por participante'); grid on; ylim([-0.1 1.15]);
xlim([0 N+1]); xticks(1:N); xticklabels(T.ID); xtickangle(60);
legend(h, nombres, 'Location','best');

% 5b. Velocidad vs distancia del primer aviso (solo casos con obstaculo)
figure('Name','Dispersion: velocidad vs distancia de aviso','Color','w'); hold on;
idxObs = find(T.ObstaculoReal);
h2 = gobjects(0); n2 = strings(0);
for c = ["TP","FN"]
    idx = idxObs(T.Caso(idxObs) == c);
    if isempty(idx), continue; end
    if c == "TP"
        y = T.Dist1erAviso(idx);
        h2(end+1) = scatter(T.Vel(idx), y, 120, cols.TP, 'o', 'filled','MarkerEdgeColor','k'); %#ok<SAGROW>
    else
        y = zeros(numel(idx),1);   % sin aviso: se dibuja en 0
        h2(end+1) = scatter(T.Vel(idx), y, 140, cols.FN, 'x', 'LineWidth', 2.5); %#ok<SAGROW>
    end
    n2(end+1) = c; %#ok<SAGROW>
    text(T.Vel(idx)+0.008, y+15, cellstr(T.ID(idx)), 'FontSize', 9, 'Color','k');
end
yline(DIST_MIN, ':r', 'DIST\_MIN'); yline(DIST_MAX, ':r', 'DIST\_MAX');
xline(0.40, '--k', 'limite teorico del cooldown (~0.40 m/s)');
xlabel('Velocidad de aproximacion (m/s)');
ylabel('Distancia del primer aviso (mm)  [0 = sin aviso]');
title('Velocidad vs distancia del primer aviso'); grid on;
legend(h2, n2, 'Location','best');

% 5c. Distancia inicial vs velocidad
figure('Name','Dispersion: distancia inicial vs velocidad','Color','w'); hold on;
ok = ~isnan(T.Vel) & ~isnan(T.DistInicial); hh = gobjects(1,2);
for c = ["TP","FN"]
    idx = find(ok & T.Caso == c);
    if isempty(idx), continue; end
    if c == "TP"
        hh(1) = scatter(T.Vel(idx), T.DistInicial(idx), 120, cols.(c), marc.(c), 'filled','MarkerEdgeColor','k');
    else
        hh(2) = scatter(T.Vel(idx), T.DistInicial(idx), 140, cols.(c), marc.(c), 'LineWidth', 2.5);
    end
    text(T.Vel(idx)+0.008, T.DistInicial(idx), cellstr(T.ID(idx)), 'FontSize', 9, 'Color','k');
end
yline(DIST_MAX,':r','DIST\_MAX'); yline(DIST_MIN,':r','DIST\_MIN');
xlabel('Velocidad (m/s)'); ylabel('Distancia inicial (mm)');
title('Condicion inicial de cada prueba con obstaculo'); grid on;
nomb3 = {'TP','FN'};
legend(hh(isgraphics(hh)), nomb3(isgraphics(hh)), 'Location','best');

% 5d. Numero de pulsos por participante
figure('Name','Pulsos por participante','Color','w');
b = bar(T.NPulsos, 'FaceColor','flat');
for i = 1:N, b.CData(i,:) = cols.(char(T.Caso(i))); end
xticks(1:N); xticklabels(T.ID); xtickangle(60);
ylabel('N de pulsos de vibracion'); title('Pulsos registrados (color = caso)'); grid on;

%% ===================== 6. EVALUACION DETALLADA =====================
% 6a. Por sensor
sensores = unique(T.Sensor,'stable');
Sensor = sensores; nSes = numel(sensores);
Ncasos = zeros(nSes,1); tp=zeros(nSes,1); fn=zeros(nSes,1); fp=zeros(nSes,1); tn=zeros(nSes,1);
for s = 1:nSes
    m = T.Sensor == sensores(s);
    Ncasos(s) = sum(m);
    tp(s) = sum(T.Caso(m)=="TP"); fn(s) = sum(T.Caso(m)=="FN");
    fp(s) = sum(T.Caso(m)=="FP"); tn(s) = sum(T.Caso(m)=="TN");
end
Sens_s = tp./(tp+fn); Prec_s = tp./(tp+fp); Exac_s = (tp+tn)./Ncasos;
TablaSensor = table(Sensor, Ncasos, tp, fn, fp, tn, round(Sens_s,3), round(Prec_s,3), ...
    round(Exac_s,3), 'VariableNames', ...
    {'Sensor','N','VP','FN','FP','VN','Sensibilidad','Precision','Exactitud'});
fprintf('========== DESEMPENO POR SENSOR ==========\n');
disp(TablaSensor);

% 6b. Errores (FN y FP) con su causa
isErr = T.Caso=="FN" | T.Caso=="FP";
TablaErrores = T(isErr, {'ID','Sensor','Evento','Caso','Vel','DistInicial','Causa'});
fprintf('========== ERRORES Y CAUSA (software) ==========\n');
disp(TablaErrores);

% 6c. Detecciones tardias (TP con primer aviso por debajo de DIST_MIN + 25 mm)
tardio = T.Caso=="TP" & T.Dist1erAviso < (DIST_MIN + 50);
fprintf('Detecciones tardias (primer aviso < %d mm): %s\n', DIST_MIN+50, ...
        strjoin(cellstr(T.ID(tardio)), ', '));
fprintf('Distancia media 1er aviso (TP): %.0f mm (SD %.0f)\n', ...
        mean(T.Dist1erAviso(T.Caso=="TP")), std(T.Dist1erAviso(T.Caso=="TP")));
fprintf('Latencia media al 1er pulso (TP): %.2f s (SD %.2f)\n\n', ...
        mean(T.T1erPulso(T.Caso=="TP")), std(T.T1erPulso(T.Caso=="TP")));

% 6d. Metricas si se corrigen los errores atribuibles a software (escenario v2)
% FN y FP cuya causa menciona "software" o el cooldown/ventana se reclasifican
% como aciertos hipoteticos. Es una cota superior, no una medicion.
corr = isErr & (contains(lower(T.Causa),"software") | contains(lower(T.Causa),"cooldown") ...
      | contains(lower(T.Causa),"apaga") | contains(lower(T.Causa),"no distingue"));
TPc = TP + sum(T.Caso=="FN" & corr);  FNc = FN - sum(T.Caso=="FN" & corr);
TNc = TN + sum(T.Caso=="FP" & corr);  FPc = FP - sum(T.Caso=="FP" & corr);
fprintf('========== ESCENARIO HIPOTETICO: ERRORES DE SOFTWARE CORREGIDOS ==========\n');
fprintf('Errores atribuibles a software: %d de %d\n', sum(corr), sum(isErr));
fprintf('Sensibilidad: %.3f -> %.3f\n', sens, TPc/(TPc+FNc));
fprintf('Especificidad: %.3f -> %.3f\n', espe, TNc/(TNc+FPc));
fprintf('Precision    : %.3f -> %.3f\n', prec, TPc/(TPc+FPc));
fprintf('Exactitud    : %.3f -> %.3f\n\n', exac, (TPc+TNc)/N);

% 6e. Probabilidad de deteccion vs velocidad (si existe la hoja del Excel)
try
    if isfile(archivo)
        H = readcell(archivo,'Sheet','Hallazgos_software');
        esTxt = cellfun(@(x) ischar(x) || isstring(x), H);
        [r0, c0] = find(esTxt & cellfun(@(x) any(strcmp(string(x),'Velocidad (m/s)')), H), 1);
        vel = []; pdet = [];
        for r = r0+1:size(H,1)
            if isnumeric(H{r,c0}) && isnumeric(H{r,c0+1})
                vel(end+1,1) = H{r,c0}; pdet(end+1,1) = H{r,c0+1}; %#ok<SAGROW>
            else, break;
            end
        end
        if ~isempty(vel)
            if max(pdet) <= 1, pdet = 100*pdet; end
            figure('Name','Probabilidad de deteccion vs velocidad','Color','w');
            plot(vel, pdet, '-o','LineWidth',2,'MarkerFaceColor',[0 0.45 0.74]); grid on;
            xlabel('Velocidad de aproximacion (m/s)'); ylabel('Deteccion (%)');
            title('Probabilidad de deteccion segun velocidad (firmware v1)');
            xline(0.40,'--r','~0.40 m/s');
        end
    end
catch
    % hoja opcional; se ignora si el formato cambia
end

% 6f. Barras de metricas con IC95%
figure('Name','Metricas con IC95%','Color','w');
vals = [sens espe prec exac]; lo = [sL eL pL xL]; up = [sU eU pU xU];
bar(vals, 'FaceColor',[0.30 0.55 0.80]); hold on;
errorbar(1:4, vals, vals-lo, up-vals, 'k', 'LineStyle','none', 'LineWidth',1.5);
xticklabels({'Sensibilidad','Especificidad','Precision','Exactitud'});
ylim([0 1.05]); ylabel('Valor'); grid on;
title('Metricas globales con IC95% de Wilson (N = 15)');
for i = 1:4, text(i, vals(i)+0.04, sprintf('%.3f', vals(i)), 'HorizontalAlignment','center'); end

%% ===================== 7. EXPORTAR =====================
if exportar
    salida = 'resultados_gorra.xlsx';
    if isfile(salida), delete(salida); end
    writetable(TablaMetricas, salida, 'Sheet', 'Metricas');
    writetable(TablaROC,      salida, 'Sheet', 'Umbrales_ROC');
    writetable(TablaSensor,   salida, 'Sheet', 'Por_sensor');
    writetable(TablaErrores,  salida, 'Sheet', 'Errores');
    writetable(T,             salida, 'Sheet', 'Participantes');
    figs = findall(groot, 'Type', 'figure');
    for f = figs'
        nombre = regexprep(f.Name, '[^\w]', '_');
        exportgraphics(f, [nombre '.png'], 'Resolution', 200);
    end
    fprintf('Resultados exportados a %s y figuras a PNG.\n', salida);
end

%% ===================== FUNCIONES LOCALES =====================
function T = leerParticipantes(archivo)
    raw = readcell(archivo, 'Sheet', 'Participantes');
    r0  = find(strcmp(string(raw(:,1)), 'ID'), 1);      % fila de encabezados
    filas = [];
    for r = r0+1:size(raw,1)
        id = raw{r,1};
        if ischar(id) || isstring(id)
            if ~isempty(regexp(char(id), '^P\d+', 'once')), filas(end+1) = r; end %#ok<AGROW>
        end
    end
    n = numel(filas);
    num = @(c) cellfun(@(x) tonum(x), raw(filas, c));
    si  = @(c) cellfun(@(x) startsWith(strtrim(string(x)), "S"), raw(filas, c));
    T = table;
    T.ID             = string(raw(filas,1));
    T.Sensor         = string(raw(filas,2));
    T.Evento         = string(raw(filas,3));
    T.ObstaculoReal  = si(4);
    T.Vel            = num(5);
    T.DistInicial    = num(6);
    T.Vibro          = si(7);
    T.NPulsos        = num(8);
    T.T1erPulso      = num(9);
    T.Dist1erAviso   = num(10);
    T.Causa          = string(raw(filas,13));
    assert(n == 15, 'Se esperaban 15 participantes y se leyeron %d.', n);
end

function y = tonum(x)
    if isnumeric(x) && ~isempty(x) && ~isnan(x(1)), y = double(x(1));
    elseif ischar(x) || isstring(x)
        y = str2double(x);                       % "-" o texto -> NaN
    else, y = NaN;
    end
end

function [lo, up] = wilson(k, n)                 % IC95% de Wilson para proporciones
    if n == 0, lo = NaN; up = NaN; return; end
    z = 1.96; p = k/n;
    den = 1 + z^2/n;
    ctr = (p + z^2/(2*n)) / den;
    mar = z * sqrt(p*(1-p)/n + z^2/(4*n^2)) / den;
    lo = max(0, ctr - mar); up = min(1, ctr + mar);
end

function T = round_table(T, d)                   % redondea columnas numericas
    for v = 1:width(T)
        if isnumeric(T.(v)), T.(v) = round(T.(v), d); end
    end
end

